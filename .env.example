# mcp-safeguard configuration
# Copy this file to .env and fill in your values

# Server
MCP_SAFEGUARD_HOST=0.0.0.0
MCP_SAFEGUARD_PORT=8000
MCP_SAFEGUARD_DEBUG=false

# Authentication (leave blank to disable auth — NOT recommended for production)
MCP_SAFEGUARD_API_KEY=

# Rate limiting
MCP_SAFEGUARD_RATE_LIMIT_REQUESTS=100
MCP_SAFEGUARD_RATE_LIMIT_WINDOW=60

# Scanning
MCP_SAFEGUARD_ENABLE_NETWORK_SCAN=true
MCP_SAFEGUARD_MAX_SCAN_TIMEOUT=30
MCP_SAFEGUARD_SSRF_ALLOWLIST=["localhost","127.0.0.1","::1"]

# Storage
MCP_SAFEGUARD_REPORT_DIR=/tmp/mcp-safeguard-reports
MCP_SAFEGUARD_SCAN_HISTORY_MAX=1000

# Observability
MCP_SAFEGUARD_LOG_LEVEL=INFO
MCP_SAFEGUARD_PROMETHEUS_ENABLED=true
# MCP_SAFEGUARD_OTLP_ENDPOINT=http://localhost:4318/v1/traces
