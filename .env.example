# mcp-shield configuration
# Copy this file to .env and fill in your values

# Server
MCP_SHIELD_HOST=0.0.0.0
MCP_SHIELD_PORT=8000
MCP_SHIELD_DEBUG=false

# Authentication (leave blank to disable auth — NOT recommended for production)
MCP_SHIELD_API_KEY=

# Rate limiting
MCP_SHIELD_RATE_LIMIT_REQUESTS=100
MCP_SHIELD_RATE_LIMIT_WINDOW=60

# Scanning
MCP_SHIELD_ENABLE_NETWORK_SCAN=true
MCP_SHIELD_MAX_SCAN_TIMEOUT=30
MCP_SHIELD_SSRF_ALLOWLIST=["localhost","127.0.0.1","::1"]

# Storage
MCP_SHIELD_REPORT_DIR=/tmp/mcp-shield-reports
MCP_SHIELD_SCAN_HISTORY_MAX=1000

# Observability
MCP_SHIELD_LOG_LEVEL=INFO
MCP_SHIELD_PROMETHEUS_ENABLED=true
# MCP_SHIELD_OTLP_ENDPOINT=http://localhost:4318/v1/traces
